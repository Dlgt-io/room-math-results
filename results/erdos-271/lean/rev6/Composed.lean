(∀ t : Nat, ∀ p : Nat, Membership.mem (cnt t) p ↔ (Membership.mem P p ∧ 0 < p ∧ p ≤ t)) →
(∀ z : Nat, Membership.mem mem0 z ↔ (s < z ∧ z ≤ x0 ∧ Membership.mem P z)) →
