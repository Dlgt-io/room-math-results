      intro h L U t0 T hm hT hU hb
      exact H6 Kker h L U t0 T (fun x => h x ^ 2) (fun x => U - h x) (fun v => v * Kker v)
        (fun t u => Kker (t - u) * h u)
        (fun t => h t * ∫ u in Ioo t0 t, Kker (t - u) * h u)
        (fun v => rfl) (fun x => rfl) (fun x => rfl) (fun v => rfl) (fun t u => rfl) (fun t => rfl)
        hm hT hU hb

    have Acount_eq_zero_of_lt (P : Finset ℝ) (hP : ∀ p ∈ P, 1 ≤ p) {t : ℝ} (ht : t < 1) :
