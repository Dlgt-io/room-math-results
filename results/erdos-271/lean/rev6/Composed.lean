(∀ z : Nat, s < z → z ≤ X → ¬ Membership.mem P z → ∃ a : Nat, ∃ b : Nat, Membership.mem P a ∧ Membership.mem P b ∧ a < b ∧ 2 * b - a = z) →
(∀ t : Nat, x0 ≤ t → t ≤ X → (Finset.card (cnt t) : Real) ≤ U * Real.sqrt (t : Real)) →
