        ∫ x in Icc 0 τ, g x * m x ≤ β * ∫ x in (0:ℝ)..τ, g x := by
      rw [iInt_eq_Icc hτ, ← MeasureTheory.integral_const_mul]
      have hgi : IntegrableOn (fun x => β * g x) (Icc 0 τ) volume := by
        refine Measure.integrableOn_of_bounded (M := |β| * G) (by simp)
          (hg.const_mul β).aestronglyMeasurable
          (ae_restrict_of_forall_mem measurableSet_Icc (fun x hx => ?_))
        rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hgb x hx).1]
        exact mul_le_mul_of_nonneg_left (hgb x hx).2 (abs_nonneg _)
      apply integral_mono_of_nonneg _ hgi
      · exact ae_restrict_of_forall_mem measurableSet_Icc (fun x hx => by
          have := hgb x hx
          show g x * m x ≤ β * g x
          nlinarith [hmβ x hx, this.1])
      · exact ae_restrict_of_forall_mem measurableSet_Icc (fun x hx =>
          mul_nonneg (hgb x hx).1 (hm0 x hx))

    have C1_le {K h : ℝ → ℝ} {L U τ KM β : ℝ} (H : (Measurable K ∧ Measurable h ∧ (∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v) ∧ (∀ v, 0 ≤ v → v ≤ τ → K v ≤ KM) ∧ (∀ x ∈ Icc 0 τ, L ≤ h x ∧ h x ≤ U))) (hτ : 0 ≤ τ)
        (hβ : ∀ t ∈ Icc 0 τ, ∫ u in Icc 0 t, K (t - u) ≤ β) :
        ∫ p in T τ, K (p.1 - p.2) * (U - h p.1) ≤ β * ∫ x in (0:ℝ)..τ, (U - h x) := by
      have hint : IntegrableOn (fun p : ℝ × ℝ => K (p.1 - p.2) * (U - h p.1)) (T τ) volume := by
        have hKmp : Measurable (fun p : ℝ × ℝ => K (p.1 - p.2)) :=
          H.1.comp (measurable_fst.sub measurable_snd)
        refine integrableOn_T (f := fun p : ℝ × ℝ => K (p.1 - p.2) * (U - h p.1))
          (hKmp.mul (measurable_const.sub (H.2.1.comp measurable_fst))) τ (KM * (U - L))
          (fun p hp => ?_)
        obtain ⟨k0, k1, ht, -⟩ := kdiff_bounds H hp
        have := H.2.2.2.2 _ ht
        show |K (p.1 - p.2) * (U - h p.1)| ≤ _
        rw [abs_mul, abs_of_nonneg k0, abs_of_nonneg (by linarith)]
        exact mul_le_mul k1 (by linarith) (by linarith) (le_trans k0 k1)
      rw [tri_iter hint]
      have hinner : ∀ t, ∫ u in Icc 0 t, K (t - u) * (U - h t)
          = (U - h t) * ∫ u in Icc 0 t, K (t - u) := by
        intro t; rw [MeasureTheory.integral_mul_const, mul_comm]
      simp_rw [hinner]
      refine outer_bound hτ (measurable_const.sub H.2.1) (U - L)
        (fun x hx => ⟨by linarith [(H.2.2.2.2 x hx).2], by linarith [(H.2.2.2.2 x hx).1]⟩) ?_ hβ
      intro t ht
      apply setIntegral_nonneg measurableSet_Icc
      intro u hu
      exact H.2.2.1 _ (by linarith [hu.2]) (by linarith [hu.1, ht.2])

    have C2_le {K h : ℝ → ℝ} {L U τ KM β : ℝ} (H : (Measurable K ∧ Measurable h ∧ (∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v) ∧ (∀ v, 0 ≤ v → v ≤ τ → K v ≤ KM) ∧ (∀ x ∈ Icc 0 τ, L ≤ h x ∧ h x ≤ U))) (hτ : 0 ≤ τ)
        (hβ : ∀ u ∈ Icc 0 τ, ∫ t in Icc u τ, K (t - u) ≤ β) :
        ∫ p in T τ, K (p.1 - p.2) * (U - h p.2) ≤ β * ∫ x in (0:ℝ)..τ, (U - h x) := by
      have hint : IntegrableOn (fun p : ℝ × ℝ => K (p.1 - p.2) * (U - h p.2)) (T τ) volume := by
        have hKmp : Measurable (fun p : ℝ × ℝ => K (p.1 - p.2)) :=
          H.1.comp (measurable_fst.sub measurable_snd)
        refine integrableOn_T (f := fun p : ℝ × ℝ => K (p.1 - p.2) * (U - h p.2))
          (hKmp.mul (measurable_const.sub (H.2.1.comp measurable_snd))) τ (KM * (U - L))
          (fun p hp => ?_)
        obtain ⟨k0, k1, -, hu⟩ := kdiff_bounds H hp
        have := H.2.2.2.2 _ hu
        show |K (p.1 - p.2) * (U - h p.2)| ≤ _
        rw [abs_mul, abs_of_nonneg k0, abs_of_nonneg (by linarith)]
        exact mul_le_mul k1 (by linarith) (by linarith) (le_trans k0 k1)
      rw [tri_iter_swap hint]
      have hinner : ∀ u, ∫ t in Icc u τ, K (t - u) * (U - h u)
          = (U - h u) * ∫ t in Icc u τ, K (t - u) := by
        intro u; rw [MeasureTheory.integral_mul_const, mul_comm]
      simp_rw [hinner]
      refine outer_bound hτ (measurable_const.sub H.2.1) (U - L)
        (fun x hx => ⟨by linarith [(H.2.2.2.2 x hx).2], by linarith [(H.2.2.2.2 x hx).1]⟩) ?_ hβ
      intro u hu
      apply setIntegral_nonneg measurableSet_Icc
      intro t ht
      exact H.2.2.1 _ (by linarith [ht.1]) (by linarith [ht.2, hu.1])

    have lemma4_reduced {K h : ℝ → ℝ} {L U τ KM β η : ℝ} (H : (Measurable K ∧ Measurable h ∧ (∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v) ∧ (∀ v, 0 ≤ v → v ≤ τ → K v ≤ KM) ∧ (∀ x ∈ Icc 0 τ, L ≤ h x ∧ h x ≤ U)))
        (hτ : 0 ≤ τ) (hU : 0 ≤ U)
        (hQ1 : β * τ - η ≤ ∫ p in T τ, K (p.1 - p.2))
        (hβ1 : ∀ t ∈ Icc 0 τ, ∫ u in Icc 0 t, K (t - u) ≤ β)
        (hβ2 : ∀ u ∈ Icc 0 τ, ∫ t in Icc u τ, K (t - u) ≤ β) :
        (3 / 2) * (∫ x in (0:ℝ)..τ, h x ^ 2) - 4 * (∫ p in T τ, K (p.1 - p.2) * h p.1 * h p.2)
          ≤ (3 / 2 - 4 * β) * U ^ 2 * τ
            - (2 * (3 / 2 - 4 * β) * U - (3 / 2) * (U - L)) * (∫ x in (0:ℝ)..τ, (U - h x))
            + 4 * U ^ 2 * η :=
      lemma4_of_kernel_bounds H hτ hU hQ1 (C1_le H hτ hβ1) (C2_le H hτ hβ2)

    have partial_mass_le {K : ℝ → ℝ} {β s : ℝ} (hK0 : ∀ v, 0 < v → 0 ≤ K v)
        (hKi : IntegrableOn K (Ioi 0) volume) (hβ : ∫ v in Ioi 0, K v = β) :
        ∫ v in Ioc 0 s, K v ≤ β := by
      rw [← hβ]
      apply setIntegral_mono_set hKi
      · exact ae_restrict_of_forall_mem measurableSet_Ioi (fun v hv => hK0 v hv)
      · exact Filter.Eventually.of_forall (fun v hv => (show v ∈ Ioi (0:ℝ) from hv.1))

    have inner1_le {K : ℝ → ℝ} {β t : ℝ} (ht : 0 ≤ t) (hK0 : ∀ v, 0 < v → 0 ≤ K v)
        (hKi : IntegrableOn K (Ioi 0) volume) (hβ : ∫ v in Ioi 0, K v = β) :
        ∫ u in Icc 0 t, K (t - u) ≤ β := by
      rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le ht,
        intervalIntegral.integral_comp_sub_left, sub_self, sub_zero,
        intervalIntegral.integral_of_le ht]
      exact partial_mass_le hK0 hKi hβ

    have inner2_le {K : ℝ → ℝ} {β u τ : ℝ} (hu : u ≤ τ) (hK0 : ∀ v, 0 < v → 0 ≤ K v)
        (hKi : IntegrableOn K (Ioi 0) volume) (hβ : ∫ v in Ioi 0, K v = β) :
        ∫ t in Icc u τ, K (t - u) ≤ β := by
      rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hu,
        intervalIntegral.integral_comp_sub_right, sub_self,
        intervalIntegral.integral_of_le (by linarith)]
      exact partial_mass_le hK0 hKi hβ

    have lemma4_from_mass {K h : ℝ → ℝ} {L U τ KM β η : ℝ} (H : (Measurable K ∧ Measurable h ∧ (∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v) ∧ (∀ v, 0 ≤ v → v ≤ τ → K v ≤ KM) ∧ (∀ x ∈ Icc 0 τ, L ≤ h x ∧ h x ≤ U)))
        (hτ : 0 ≤ τ) (hU : 0 ≤ U)
        (hK0 : ∀ v, 0 < v → 0 ≤ K v) (hKi : IntegrableOn K (Ioi 0) volume)
        (hβ : ∫ v in Ioi 0, K v = β)
        (hQ1 : β * τ - η ≤ ∫ p in T τ, K (p.1 - p.2)) :
        (3 / 2) * (∫ x in (0:ℝ)..τ, h x ^ 2) - 4 * (∫ p in T τ, K (p.1 - p.2) * h p.1 * h p.2)
          ≤ (3 / 2 - 4 * β) * U ^ 2 * τ
            - (2 * (3 / 2 - 4 * β) * U - (3 / 2) * (U - L)) * (∫ x in (0:ℝ)..τ, (U - h x))
            + 4 * U ^ 2 * η :=
      lemma4_reduced H hτ hU hQ1 (fun _ ht => inner1_le ht.1 hK0 hKi hβ)
        (fun _ hu => inner2_le hu.2 hK0 hKi hβ)

    have Q1_eq {K : ℝ → ℝ} {τ KM : ℝ} (hKm : Measurable K)
        (hKb : ∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v ∧ K v ≤ KM) :
        ∫ p in T τ, K (p.1 - p.2) = ∫ v in Icc 0 τ, (τ - v) * K v := by
      have hKmp : Measurable (fun p : ℝ × ℝ => K (p.1 - p.2)) :=
        hKm.comp (measurable_fst.sub measurable_snd)
      have i1 : IntegrableOn (fun p : ℝ × ℝ => K (p.1 - p.2)) (T τ) volume :=
        integrableOn_T hKmp τ KM (fun p hp => by
          obtain ⟨h1, h2, h3⟩ := hp
          have := hKb (p.1 - p.2) (by linarith) (by linarith)
          rw [abs_of_nonneg this.1]; exact this.2)
      have i2 : IntegrableOn (fun p : ℝ × ℝ => K p.2) (T τ) volume :=
        integrableOn_T (hKm.comp measurable_snd) τ KM (fun p hp => by
          obtain ⟨h1, h2, h3⟩ := hp
          have := hKb p.2 h1 (by linarith)
          show |K p.2| ≤ KM
          rw [abs_of_nonneg this.1]; exact this.2)
      rw [tri_iter i1]
      have hshift : EqOn (fun t => ∫ u in Icc 0 t, K (t - u)) (fun t => ∫ u in Icc 0 t, K u)
          (Icc 0 τ) := by
        intro t ht
        simp only
        rw [integral_Icc_eq_integral_Ioc, integral_Icc_eq_integral_Ioc,
          ← intervalIntegral.integral_of_le ht.1, ← intervalIntegral.integral_of_le ht.1,
          intervalIntegral.integral_comp_sub_left, sub_self, sub_zero]
      rw [setIntegral_congr_fun measurableSet_Icc hshift]
      have e2 := tri_iter i2
      have e3 := tri_iter_swap i2
      simp only at e2 e3
      rw [← e2, e3]
      apply setIntegral_congr_fun measurableSet_Icc
      intro v hv
      simp only
      rw [MeasureTheory.integral_const, smul_eq_mul]
      simp only [Measure.real, Measure.restrict_apply_univ, Real.volume_Icc]
      rw [ENNReal.toReal_ofReal (by linarith [hv.2])]

    have Q1_ge {K : ℝ → ℝ} {τ KM β η : ℝ} (hτ : 0 ≤ τ) (hKm : Measurable K)
        (hKb : ∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v ∧ K v ≤ KM) (hK0 : ∀ v, 0 < v → 0 ≤ K v)
        (hKi : IntegrableOn K (Ioi 0) volume) (hβ : ∫ v in Ioi 0, K v = β)
        (hMi : IntegrableOn (fun v => v * K v) (Ioi 0) volume)
        (hη : ∫ v in Ioi 0, v * K v = η) :
        β * τ - η ≤ ∫ p in T τ, K (p.1 - p.2) := by
      rw [Q1_eq hKm hKb, integral_Icc_eq_integral_Ioc]
      have hfi : IntegrableOn (fun v => (τ - v) * K v) (Ioi 0) volume := by
        have : (fun v => (τ - v) * K v) = fun v => τ * K v - v * K v := by ext v; ring
        rw [this]; exact (hKi.const_mul τ).sub hMi
      have hsplit : ∫ v in Ioi 0, (τ - v) * K v
          = (∫ v in Ioc 0 τ, (τ - v) * K v) + ∫ v in Ioi τ, (τ - v) * K v := by
        rw [← Ioc_union_Ioi_eq_Ioi hτ] at hfi ⊢
        exact setIntegral_union (Ioc_disjoint_Ioi le_rfl) measurableSet_Ioi
          (hfi.mono_set subset_union_left) (hfi.mono_set subset_union_right)
      have hneg : ∫ v in Ioi τ, (τ - v) * K v ≤ 0 := by
        apply setIntegral_nonpos measurableSet_Ioi
        intro v hv
        have : 0 ≤ K v := hK0 v (lt_of_le_of_lt hτ hv)
        have : τ - v ≤ 0 := by linarith [show τ < v from hv]
        nlinarith
      have hlin : ∫ v in Ioi 0, (τ - v) * K v = β * τ - η := by
        have : (fun v => (τ - v) * K v) = fun v => τ * K v - v * K v := by ext v; ring
        rw [this, integral_sub (hKi.const_mul τ) hMi, MeasureTheory.integral_const_mul, hβ, hη]
        ring
      linarith

    have lemma4_integral {K h : ℝ → ℝ} {L U τ KM β η : ℝ} (H : (Measurable K ∧ Measurable h ∧ (∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v) ∧ (∀ v, 0 ≤ v → v ≤ τ → K v ≤ KM) ∧ (∀ x ∈ Icc 0 τ, L ≤ h x ∧ h x ≤ U)))
        (hτ : 0 ≤ τ) (hU : 0 ≤ U)
        (hK0 : ∀ v, 0 < v → 0 ≤ K v) (hKi : IntegrableOn K (Ioi 0) volume)
        (hβ : ∫ v in Ioi 0, K v = β)
        (hMi : IntegrableOn (fun v => v * K v) (Ioi 0) volume)
        (hη : ∫ v in Ioi 0, v * K v = η) :
        (3 / 2) * (∫ x in (0:ℝ)..τ, h x ^ 2) - 4 * (∫ p in T τ, K (p.1 - p.2) * h p.1 * h p.2)
          ≤ (3 / 2 - 4 * β) * U ^ 2 * τ
            - (2 * (3 / 2 - 4 * β) * U - (3 / 2) * (U - L)) * (∫ x in (0:ℝ)..τ, (U - h x))
            + 4 * U ^ 2 * η :=
      lemma4_from_mass H hτ hU hK0 hKi hβ
        (Q1_ge hτ H.1 (fun v h0 h1 => ⟨H.2.2.1 v h0 h1, H.2.2.2.1 v h0 h1⟩) hK0 hKi hβ hMi hη)



    have Kker_measurable : Measurable Kker := by
      unfold Kker; fun_prop

    have Kker_bounds {v : ℝ} (hv : 0 ≤ v) : 0 ≤ Kker v ∧ Kker v ≤ 1 := by
      have h1 : exp (-v) ≤ 1 := exp_le_one_iff.mpr (by linarith)
      have hd : 1 ≤ (2 - exp (-v)) ^ 3 := one_le_pow₀ (by linarith)
      have he : exp (-(3 * v / 2)) ≤ 1 := exp_le_one_iff.mpr (by linarith)
      unfold Kker
      refine ⟨div_nonneg (exp_pos _).le (by positivity), ?_⟩
      calc exp (-(3 * v / 2)) / (2 - exp (-v)) ^ 3 ≤ exp (-(3 * v / 2)) :=
            div_le_self (exp_pos _).le hd
        _ ≤ 1 := he


    have Q_eq_iter {K h : ℝ → ℝ} {L U τ KM : ℝ} (H : (Measurable K ∧ Measurable h ∧ (∀ v, 0 ≤ v → v ≤ τ → 0 ≤ K v) ∧ (∀ v, 0 ≤ v → v ≤ τ → K v ≤ KM) ∧ (∀ x ∈ Icc 0 τ, L ≤ h x ∧ h x ≤ U))) :
        ∫ p in T τ, K (p.1 - p.2) * h p.1 * h p.2
          = ∫ t in Ioo 0 τ, h t * ∫ u in Ioo 0 t, K (t - u) * h u := by
      have hKmp : Measurable (fun p : ℝ × ℝ => K (p.1 - p.2)) :=
        H.1.comp (measurable_fst.sub measurable_snd)
      set B := |L| + |U|
      have hB : ∀ x ∈ Icc 0 τ, |h x| ≤ B := fun x hx =>
        abs_le_of_bounds (H.2.2.2.2 x hx).1 (H.2.2.2.2 x hx).2
      have i3 : IntegrableOn (fun p : ℝ × ℝ => K (p.1 - p.2) * h p.1 * h p.2) (T τ) volume :=
        integrableOn_T (f := fun p : ℝ × ℝ => K (p.1 - p.2) * h p.1 * h p.2)
          ((hKmp.mul (H.2.1.comp measurable_fst)).mul (H.2.1.comp measurable_snd)) τ (KM * B * B)
          (fun p hp => by
            obtain ⟨k0, k1, ht, hu⟩ := kdiff_bounds H hp
            show |K (p.1 - p.2) * h p.1 * h p.2| ≤ _
            rw [abs_mul, abs_mul, abs_of_nonneg k0]
            have hb1 := hB _ ht
            have hb2 := hB _ hu
            have hB0 : 0 ≤ B := le_trans (abs_nonneg _) hb1
            exact mul_le_mul (mul_le_mul k1 hb1 (abs_nonneg _) (le_trans k0 k1)) hb2
              (abs_nonneg _) (mul_nonneg (le_trans k0 k1) hB0))
      rw [tri_iter i3, integral_Icc_eq_integral_Ioo]
      congr 1; ext t
      rw [integral_Icc_eq_integral_Ioo, ← MeasureTheory.integral_const_mul]
      congr 1; ext u; ring


    have shift_Ioo (f : ℝ → ℝ) {a b : ℝ} (hab : a ≤ b) :
        ∫ x in Ioo a b, f x = ∫ x in Ioo 0 (b - a), f (x + a) := by
      rw [← integral_Ioc_eq_integral_Ioo, ← integral_Ioc_eq_integral_Ioo,
        ← intervalIntegral.integral_of_le hab, ← intervalIntegral.integral_of_le (by linarith),
        intervalIntegral.integral_comp_add_right]
      simp


    have iter_shift (K h : ℝ → ℝ) {t0 T : ℝ} (hT : t0 ≤ T) :
        ∫ t in Ioo t0 T, h t * ∫ u in Ioo t0 t, K (t - u) * h u
          = ∫ t in Ioo 0 (T - t0), h (t + t0) * ∫ u in Ioo 0 t, K (t - u) * h (u + t0) := by
      rw [shift_Ioo _ hT]
      apply setIntegral_congr_fun measurableSet_Ioo
      intro t ht
      simp only
      rw [shift_Ioo _ (by linarith [ht.1] : t0 ≤ t + t0)]
      congr 1
      rw [show t + t0 - t0 = t by ring]
      congr 1; ext u
      rw [show t + t0 - (u + t0) = t - u by ring]


    have lemma4_window {h : ℝ → ℝ} {L U t0 T β η : ℝ} (hm : Measurable h) (hT : t0 ≤ T)
        (hU : 0 ≤ U) (hb : ∀ x ∈ Icc t0 T, L ≤ h x ∧ h x ≤ U)
        (hKi : IntegrableOn Kker (Ioi 0) volume) (hβ : ∫ v in Ioi 0, Kker v = β)
        (hMi : IntegrableOn (fun v => v * Kker v) (Ioi 0) volume)
        (hη : ∫ v in Ioi 0, v * Kker v = η) :
        (3 / 2) * (∫ x in t0..T, h x ^ 2)
          - 4 * (∫ t in Ioo t0 T, h t * ∫ u in Ioo t0 t, Kker (t - u) * h u)
          ≤ (3 / 2 - 4 * β) * U ^ 2 * (T - t0)
            - (2 * (3 / 2 - 4 * β) * U - (3 / 2) * (U - L)) * (∫ x in t0..T, (U - h x))
            + 4 * U ^ 2 * η := by
      set g : ℝ → ℝ := fun t => h (t + t0) with hg
      have Hg : (Measurable Kker ∧ Measurable g ∧ (∀ v, 0 ≤ v → v ≤ T - t0 → 0 ≤ Kker v) ∧ (∀ v, 0 ≤ v → v ≤ T - t0 → Kker v ≤ 1) ∧ (∀ x ∈ Icc 0 (T - t0), L ≤ g x ∧ g x ≤ U)) :=
        ⟨Kker_measurable, hm.comp (measurable_id.add_const t0), fun v hv _ => (Kker_bounds hv).1, fun v hv _ => (Kker_bounds hv).2, fun x hx => hb (x + t0) ⟨by linarith [hx.1], by linarith [hx.2]⟩⟩
      have main := lemma4_integral Hg (by linarith) hU (fun v hv => (Kker_bounds hv.le).1)
        hKi hβ hMi hη
      rw [Q_eq_iter Hg] at main
      have e1 : ∫ x in (0:ℝ)..(T - t0), g x ^ 2 = ∫ x in t0..T, h x ^ 2 := by
        simp only [hg]
        rw [intervalIntegral.integral_comp_add_right (fun x => h x ^ 2)]; simp
      have e2 : ∫ x in (0:ℝ)..(T - t0), (U - g x) = ∫ x in t0..T, (U - h x) := by
        simp only [hg]
        rw [intervalIntegral.integral_comp_add_right (fun x => U - h x)]; simp
      rw [e1, e2] at main
      rw [iter_shift Kker h hT]
      exact main

    have kernel_formula :
    ∀ K : Real → Real, (∀ v : Real, K v = Real.exp (-3 * v / 2) / (2 - Real.exp (-v)) ^ 3) → MeasureTheory.IntegrableOn K (Set.Ioi 0) MeasureTheory.volume ∧ MeasureTheory.integral (MeasureTheory.Measure.restrict MeasureTheory.volume (Set.Ioi 0)) K = 3 / 8 - Real.log (1 + Real.sqrt 2) / (8 * Real.sqrt 2) :=
    by
      intro K hK
      have primitive_derivative :
        ∀ H : Real → Real → Real, (∀ r : Real, ∀ t : Real, H r t = (1 / 2) * (t / (2 - t ^ 2) ^ 2) - (1 / 8) * (t / (2 - t ^ 2)) - (1 / (16 * r)) * (Real.log (r + t) - Real.log (r - t))) → ∀ r : Real, ∀ t : Real, 1 < r → r ^ 2 = 2 → 0 ≤ t → t ≤ 1 → HasDerivAt (H r) (2 * t ^ 2 / (2 - t ^ 2) ^ 3) t :=
        by
          intro H hH r t hr hr2 ht0 ht1
          have hr0 : r ≠ 0 := ne_of_gt (by linarith)
          have hdpos : 0 < 2 - t ^ 2 := by
            have hp := mul_nonneg (sub_nonneg.mpr ht1) (by linarith : 0 ≤ 1 + t)
            nlinarith
          have hd : 2 - t ^ 2 ≠ 0 := ne_of_gt hdpos
          have hp : r + t ≠ 0 := ne_of_gt (by linarith)
          have hm : r - t ≠ 0 := ne_of_gt (by linarith)
          have hlogalg : 1 / (r + t) + 1 / (r - t) = 2 * r / (2 - t ^ 2) := by
            have heq : 2 - t ^ 2 = (r + t) * (r - t) := by nlinarith [hr2]
            rw [heq]
            field_simp [hp, hm]
            <;> ring
          have hden : HasDerivAt (fun x : Real => 2 - x ^ 2) (-2 * t) t := by
            exact ((hasDerivAt_const t (2 : Real)).sub
              ((hasDerivAt_id t).fun_pow 2)).congr_deriv (by norm_num <;> ring)
          have hlog : HasDerivAt
              (fun x : Real => Real.log (r + x) - Real.log (r - x))
