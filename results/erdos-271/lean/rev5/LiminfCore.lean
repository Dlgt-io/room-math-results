def okRow (p : ℕ × ℕ) : Bool :=
  S768l.contains p.2 && S768l.contains (2 * p.2 - p.1) && decide (1 ≤ 2 * p.2 - p.1) &&
    decide (2 * p.2 - p.1 < p.2) && decide (p.2 < p.1)

theorem cert_ok : cert.all okRow = true ∧ cert.map Prod.fst = List.range' 3 766 := by
  decide +kernel

theorem S768_cov : Cov S768 3 768 := by
  intro n h1 h2
  have hn : n ∈ cert.map Prod.fst := by rw [cert_ok.2, List.mem_range'_1]; omega
  obtain ⟨⟨n', b⟩, hp, rfl⟩ := List.mem_map.1 hn
  have hrow := List.all_eq_true.1 cert_ok.1 _ hp
  simp only [okRow, Bool.and_eq_true, List.contains_iff_mem, decide_eq_true_eq] at hrow
  obtain ⟨⟨⟨⟨hb, ha⟩, ha1⟩, hab⟩, hbn⟩ := hrow
  refine ⟨2 * b - n', List.mem_toFinset.2 ha, b, List.mem_toFinset.2 hb, ha1, hab, by omega⟩

theorem S768_card : S768.card = 50 := by decide +kernel

theorem S768_small : 1 ∈ S768 ∧ 2 ∈ S768 ∧ 3 ∈ S768 := by decide +kernel

theorem S768_pos : ∀ x ∈ S768, 1 ≤ x := by decide +kernel

/-! ## The lift `L(T) = 4T + {0,1}` -/

def L (T : Finset ℕ) : Finset ℕ := T.image (fun t => 4 * t) ∪ T.image (fun t => 4 * t + 1)

theorem mem_L {T : Finset ℕ} {m : ℕ} : m ∈ L T ↔ ∃ t ∈ T, 4 * t = m ∨ 4 * t + 1 = m := by
  simp only [L, mem_union, mem_image]
  constructor
  · rintro (⟨t, ht, rfl⟩ | ⟨t, ht, rfl⟩)
    · exact ⟨t, ht, Or.inl rfl⟩
    · exact ⟨t, ht, Or.inr rfl⟩
  · rintro ⟨t, ht, h | h⟩
    · exact Or.inl ⟨t, ht, h⟩
    · exact Or.inr ⟨t, ht, h⟩

/-- **Lift lemma.** If `T` covers `[3,Y]` then `L T` covers `[11, 4Y+2]`. -/
theorem lift_cov {T : Finset ℕ} {Y : ℕ} (h : Cov T 3 Y) : Cov (L T) 11 (4 * Y + 2) := by
  intro n' h1 h2
  have hd := Nat.div_add_mod n' 4
  have : n' % 4 = 0 ∨ n' % 4 = 1 ∨ n' % 4 = 2 ∨ n' % 4 = 3 := by omega
  rcases this with hr | hr | hr | hr
  · obtain ⟨a, ha, b, hb, ha1, hab, he⟩ := h (n' / 4) (by omega) (by omega)
    exact ⟨4 * a, mem_L.2 ⟨a, ha, Or.inl rfl⟩, 4 * b, mem_L.2 ⟨b, hb, Or.inl rfl⟩,
      by omega, by omega, by omega⟩
  · obtain ⟨a, ha, b, hb, ha1, hab, he⟩ := h (n' / 4) (by omega) (by omega)
    exact ⟨4 * a + 1, mem_L.2 ⟨a, ha, Or.inr rfl⟩, 4 * b + 1, mem_L.2 ⟨b, hb, Or.inr rfl⟩,
      by omega, by omega, by omega⟩
  · obtain ⟨a, ha, b, hb, ha1, hab, he⟩ := h (n' / 4) (by omega) (by omega)
    exact ⟨4 * a, mem_L.2 ⟨a, ha, Or.inl rfl⟩, 4 * b + 1, mem_L.2 ⟨b, hb, Or.inr rfl⟩,
      by omega, by omega, by omega⟩
  · obtain ⟨a, ha, b, hb, ha1, hab, he⟩ := h (n' / 4 + 1) (by omega) (by omega)
    exact ⟨4 * a + 1, mem_L.2 ⟨a, ha, Or.inr rfl⟩, 4 * b, mem_L.2 ⟨b, hb, Or.inl rfl⟩,
      by omega, by omega, by omega⟩

/-- **Size doubling.** -/
theorem card_L (T : Finset ℕ) : (L T).card = 2 * T.card := by
  have hdis : Disjoint (T.image (fun t => 4 * t)) (T.image (fun t => 4 * t + 1)) := by
    rw [Finset.disjoint_left]
    intro x hx1 hx2
    simp only [mem_image] at hx1 hx2
    obtain ⟨u, -, rfl⟩ := hx1
    obtain ⟨v, -, hv⟩ := hx2
    omega
  rw [L, Finset.card_union_of_disjoint hdis,
    Finset.card_image_of_injective _ (fun x y h => by have h' : 4 * x = 4 * y := h; omega),
    Finset.card_image_of_injective _ (fun x y h => by have h' : 4 * x + 1 = 4 * y + 1 := h; omega)]
  ring

theorem L_ge4 {T : Finset ℕ} (hT : ∀ x ∈ T, 1 ≤ x) : ∀ m ∈ L T, 4 ≤ m := by
  intro m hm
  obtain ⟨t, ht, h | h⟩ := mem_L.1 hm <;> have := hT t ht <;> omega

/-! ## Lift-and-fix -/

def step (T : Finset ℕ) : Finset ℕ := L T ∪ {1, 2, 3}

theorem card_step {T : Finset ℕ} (hT : ∀ x ∈ T, 1 ≤ x) : (step T).card = 2 * T.card + 3 := by
  have hdis : Disjoint (L T) ({1, 2, 3} : Finset ℕ) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    have := L_ge4 hT x hx
    simp only [mem_insert, mem_singleton] at hx'
    omega
  rw [step, Finset.card_union_of_disjoint hdis, card_L]
  rfl

theorem step_pos {T : Finset ℕ} (hT : ∀ x ∈ T, 1 ≤ x) : ∀ x ∈ step T, 1 ≤ x := by
  intro x hx
  rcases Finset.mem_union.1 hx with h | h
  · have := L_ge4 hT x h; omega
  · simp only [mem_insert, mem_singleton] at h; omega

theorem step_small (T : Finset ℕ) : 1 ∈ step T ∧ 2 ∈ step T ∧ 3 ∈ step T := by
  simp [step]

/-- **Bottom fix.** `{1,2,3,4,5,8,9}` covers `[3,10]`. -/
theorem fix_cov {T : Finset ℕ} (h1 : 1 ∈ T) (h2 : 2 ∈ T) : Cov (step T) 3 10 := by
  have m : ∀ x, x ∈ ({1, 2, 3} : Finset ℕ) → x ∈ step T := fun x hx => Finset.mem_union_right _ hx
  have l : ∀ x, x ∈ L T → x ∈ step T := fun x hx => Finset.mem_union_left _ hx
  have s1 : 1 ∈ step T := m 1 (by simp)
  have s2 : 2 ∈ step T := m 2 (by simp)
  have s3 : 3 ∈ step T := m 3 (by simp)
  have s4 : 4 ∈ step T := l 4 (mem_L.2 ⟨1, h1, Or.inl rfl⟩)
  have s5 : 5 ∈ step T := l 5 (mem_L.2 ⟨1, h1, Or.inr rfl⟩)
  have s8 : 8 ∈ step T := l 8 (mem_L.2 ⟨2, h2, Or.inl rfl⟩)
  have s9 : 9 ∈ step T := l 9 (mem_L.2 ⟨2, h2, Or.inr rfl⟩)
  intro n hn1 hn2
  interval_cases n
  · exact ⟨1, s1, 2, s2, by omega, by omega, by omega⟩
  · exact ⟨2, s2, 3, s3, by omega, by omega, by omega⟩
  · exact ⟨1, s1, 3, s3, by omega, by omega, by omega⟩
  · exact ⟨2, s2, 4, s4, by omega, by omega, by omega⟩
  · exact ⟨1, s1, 4, s4, by omega, by omega, by omega⟩
  · exact ⟨2, s2, 5, s5, by omega, by omega, by omega⟩
  · exact ⟨1, s1, 5, s5, by omega, by omega, by omega⟩
  · exact ⟨8, s8, 9, s9, by omega, by omega, by omega⟩

theorem step_cov {T : Finset ℕ} {Y : ℕ} (h : Cov T 3 Y) (_hY : 3 ≤ Y) (h1 : 1 ∈ T) (h2 : 2 ∈ T) :
    Cov (step T) 3 (4 * Y) := by
  intro n hn1 hn2
  by_cases hn : n ≤ 10
  · exact fix_cov h1 h2 n hn1 hn
  · obtain ⟨a, ha, b, hb, hrest⟩ := lift_cov h n (by omega) (by omega)
    exact ⟨a, Finset.mem_union_left _ ha, b, Finset.mem_union_left _ hb, hrest⟩

/-- Iterated lift-and-fix `T_j`. -/
def iter (S : Finset ℕ) : ℕ → Finset ℕ
  | 0 => S
  | j + 1 => step (iter S j)

/-- **Recursion.** For a positive static set `S ∋ 1,2` covering `[3,X]`, `X ≥ 3`:
`T_j` covers `[3, 4^j X]`, contains `1,2`, is positive, and `|T_j| + 3 = 2^j (|S| + 3)`. -/
theorem iter_spec (S : Finset ℕ) (X : ℕ) (hX : 3 ≤ X) (hS : Cov S 3 X) (h1 : 1 ∈ S) (h2 : 2 ∈ S)
    (hpos : ∀ x ∈ S, 1 ≤ x) (j : ℕ) :
    Cov (iter S j) 3 (4 ^ j * X) ∧ 1 ∈ iter S j ∧ 2 ∈ iter S j ∧ (∀ x ∈ iter S j, 1 ≤ x) ∧
      (iter S j).card + 3 = 2 ^ j * (S.card + 3) := by
  induction j with
  | zero => simpa [iter] using ⟨hS, h1, h2, hpos⟩
  | succ j ih =>
    obtain ⟨hc, i1, i2, ip, hk⟩ := ih
    refine ⟨?_, (step_small _).1, (step_small _).2.1, step_pos ip, ?_⟩
    · have hY : 3 ≤ 4 ^ j * X := le_trans hX (Nat.le_mul_of_pos_left _ (by positivity))
      have := step_cov hc hY i1 i2
      have e : 4 ^ (j + 1) * X = 4 * (4 ^ j * X) := by ring
      rw [e]; exact this
    · show (step (iter S j)).card + 3 = _
      rw [card_step ip, pow_succ]
      nlinarith [hk]

/-- `|T_j| = 2^j (K+3) - 3` (natural subtraction). -/
theorem iter_card (S : Finset ℕ) (X : ℕ) (hX : 3 ≤ X) (hS : Cov S 3 X) (h1 : 1 ∈ S) (h2 : 2 ∈ S)
    (hpos : ∀ x ∈ S, 1 ≤ x) (j : ℕ) : (iter S j).card = 2 ^ j * (S.card + 3) - 3 := by
  have := (iter_spec S X hX hS h1 h2 hpos j).2.2.2.2
  omega

end Erdos271.Liminf
