import Mathlib

/-!
# Claude's liminf construction (#127): certificate, lift, lift-and-fix

`Cov T u v`: every `n ∈ [u,v]` is `2b - a` with `1 ≤ a < b`, `a, b ∈ T` (strong; `b < n` follows).
-/

namespace Erdos271.Liminf

open Finset

def Cov (T : Finset ℕ) (u v : ℕ) : Prop :=
  ∀ n, u ≤ n → n ≤ v → ∃ a ∈ T, ∃ b ∈ T, 1 ≤ a ∧ a < b ∧ a + n = 2 * b

